# Native dev on dev-workstation — copy to .env (gitignored):
#   cp .env.example .env
#
# Requires local PostgreSQL (port 5432). See script/setup-local-postgres.sh

# --- PostgreSQL (development) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=grenoble_roller_development

# --- PostgreSQL (test / rspec) ---
TEST_DATABASE_NAME=grenoble_roller_test

# --- App ---
PORT=3000
MAILER_HOST=localhost
MAILER_PROTOCOL=http

# Process background jobs inside Puma (same as ops/dev/docker-compose)
SOLID_QUEUE_IN_PUMA=true

# Disk storage for uploads in native dev (no MinIO required).
# Set to s3 and configure S3_* below if you run MinIO/SeaweedFS locally.
ACTIVE_STORAGE_SERVICE=local

# --- Optional: S3 / MinIO (when ACTIVE_STORAGE_SERVICE=s3) ---
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# --- Optional: Umami analytics (leave unset to disable locally) ---
# UMAMI_SCRIPT_URL=
# UMAMI_WEBSITE_ID=
# UMAMI_DASHBOARD_URL=
# UMAMI_SHARE_URL=

# --- Cloudflare Turnstile (anti-bot: login, contact, etc.) ---
# Override production credentials on localhost with Cloudflare test keys:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
