<%
  status = order.status.downcase
  is_pending = status.in?(%w[pending en\ attente])
  is_prep = status.in?(%w[preparation en\ préparation preparing])
  is_sent = status.in?(%w[sent envoyé shipped finished terminé paid payé])

  status_mod = if is_pending
    "pending"
  elsif is_prep
    "prep"
  elsif is_sent
    "sent"
  else
    "cancelled"
  end

  status_label = if is_pending
    "En attente"
  elsif is_prep
    "Préparation"
  elsif is_sent
    "Expédié"
  else
    "Annulée"
  end

  status_icon = if is_pending
    "bi-hourglass-split"
  elsif is_prep
    "bi-gear"
  elsif is_sent
    "bi-check-circle"
  else
    "bi-x-circle"
  end

  first_item = order.order_items.includes(variant: :product).first
  product_name = first_item&.variant&.product&.name
  items_count = order.order_items.sum(:quantity)
  extra_items = [order.order_items.count - 1, 0].max
%>

<article class="card card-liquid order-card order-card--<%= status_mod %>">
  <div class="card-body order-card__row">
    <div class="order-card__main min-w-0">
      <div class="order-card__idline">
        <strong class="order-card__id">#<%= order.id %></strong>
        <span class="text-muted order-card__date"><%= l(order.created_at, format: "%d %b %Y") %></span>
      </div>
      <% if product_name.present? %>
        <p class="order-card__product text-truncate mb-0 text-muted">
          <i class="bi bi-box me-1" aria-hidden="true"></i>
          <%= product_name %>
          <% if extra_items.positive? %>
            <span>+<%= extra_items %></span>
          <% end %>
        </p>
      <% end %>
    </div>

    <span class="order-card__chip order-card__chip--<%= status_mod %>">
      <i class="bi <%= status_icon %>" aria-hidden="true"></i>
      <%= status_label %>
    </span>

    <div class="order-card__price text-end">
      <strong class="text-primary"><%= number_to_currency(order.total_cents / 100.0, unit: "€", format: "%n %u") %></strong>
      <span class="d-block small text-muted"><%= items_count %> article<%= "s" if items_count != 1 %></span>
    </div>

    <div class="order-card__actions">
      <% if is_pending %>
        <%= button_to "Payer", order_payments_path(order), method: :post,
            class: "btn btn-sm btn-warning",
            data: { turbo: false },
            form: { class: "d-inline-flex align-items-center m-0" } %>
      <% end %>
      <%= link_to order_path(order),
          class: "btn btn-sm btn-outline-primary",
          aria: { label: "Voir la commande ##{order.id}" } do %>
        <i class="bi bi-eye" aria-hidden="true"></i>
        <span class="order-card__voir-label">Voir</span>
      <% end %>
    </div>
  </div>
</article>
