<% 
  # Calculer les jours restants
  days_remaining = 0
  if membership.active? && membership.end_date.present?
    days_remaining = (membership.end_date - Date.current).to_i
    days_remaining = [days_remaining, 0].max
  end

  # Fill represents days remaining (matches the "Jours restants" label)
  progress_percent = 0
  if membership.start_date.present? && membership.end_date.present?
    total_days = (membership.end_date - membership.start_date).to_i
    progress_percent = total_days > 0 ? [(days_remaining.to_f / total_days * 100), 100].min : 0
  end

  # Urgency colors for remaining days
  progress_color = if days_remaining > 60
    "green"
  elsif days_remaining > 14
    "orange"
  else
    "red"
  end

  # Classe CSS pour la card
  card_class = case membership.status
    when 'active'
      'membership-card active'
    when 'pending'
      'membership-card pending'
    when 'expired'
      'membership-card expired'
    else
      'membership-card'
  end

  hide_renew_cta = local_assigns.fetch(:hide_renew_cta, false)
  hide_pay_cta = local_assigns.fetch(:hide_pay_cta, false)

  category_label = membership.category == 'standard' ? 'Standard' : 'FFRS'
  amount_label = number_to_currency(membership.total_amount_cents / 100.0, unit: "€", separator: ",", delimiter: " ", format: "%n %u")
  dates_label = [
    (l(membership.start_date, format: :short) if membership.start_date),
    (l(membership.end_date, format: :short) if membership.end_date)
  ].compact.join(" → ")

  status_icon = case membership.status
  when 'active' then 'bi-check-circle'
  when 'pending' then 'bi-hourglass-split'
  when 'expired' then 'bi-x-circle'
  when 'trial' then 'bi-gift'
  else 'bi-info-circle'
  end
%>

<div class="<%= card_class %> card-liquid position-relative">
  <!-- Status Badge -->
  <span class="status-badge <%= membership.status %>">
    <i class="bi <%= status_icon %> me-1" aria-hidden="true"></i>
    <%= human_status(:membership, membership.status) %>
  </span>

  <!-- Header -->
  <div class="mb-3">
    <div class="d-flex align-items-center mb-2">
      <i class="bi <%= is_child ? 'bi-person-heart' : 'bi-person-badge' %> fs-3 text-liquid-primary me-3" aria-hidden="true"></i>
      <div>
        <h4 class="h5 mb-0">
          <% if is_child %>
            <%= membership.child_full_name %>
          <% else %>
            Mon adhésion principale
          <% end %>
        </h4>
        <small class="text-muted">
          <% if is_child %>
            Enfant - <%= membership.season %>
          <% else %>
            Adulte - <%= membership.season %>
          <% end %>
        </small>
      </div>
    </div>
  </div>

  <!-- Meta line -->
  <p class="membership-card-meta text-muted small mb-3">
    <span><%= category_label %></span>
    <span aria-hidden="true"> · </span>
    <span><%= amount_label %></span>
    <% if membership.tshirt_variant_id.present? %>
      <span aria-hidden="true"> · </span>
      <span>+ T-shirt</span>
    <% end %>
    <% if dates_label.present? %>
      <span aria-hidden="true"> · </span>
      <span><%= dates_label %></span>
    <% end %>
  </p>

  <!-- Progress Bar (si actif) -->
  <% if membership.active? && days_remaining > 0 %>
    <div class="mb-3">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <small class="text-muted">Jours restants</small>
        <strong><%= days_remaining %> jours</strong>
      </div>
      <div class="progress-bar-custom">
        <div class="progress-fill <%= progress_color %>" style="width: <%= progress_percent %>%"></div>
      </div>
    </div>
  <% end %>

  <!-- Actions: right-aligned action group -->
  <div class="d-flex gap-2 flex-wrap justify-content-end align-items-center">
    <%= link_to membership_path(membership), class: "btn btn-sm btn-outline-primary" do %>
      <i class="bi bi-eye me-1" aria-hidden="true"></i>Voir détails
    <% end %>
    
    <% if membership.status == 'pending' %>
      <% if is_child %>
        <%= link_to edit_membership_path(membership), class: "btn btn-sm btn-outline-warning" do %>
          <i class="bi bi-pencil me-1" aria-hidden="true"></i>Modifier
        <% end %>
        <%= button_to membership_path(membership),
            method: :delete,
            class: "btn btn-sm btn-outline-danger",
            data: { 
              turbo: false,
              confirm: "Êtes-vous sûr de vouloir supprimer l'adhésion de #{membership.child_full_name} ?"
            },
            form: { class: "d-inline-flex align-items-center m-0" } do %>
          <i class="bi bi-trash me-1" aria-hidden="true"></i>Supprimer
        <% end %>
      <% end %>
      
      <%= unified_cart_pay_cta(membership) unless hide_pay_cta %>
    <% elsif membership.renewable_now? && !hide_renew_cta %>
      <%= link_to membership_renewal_path_for(membership), class: "btn btn-sm btn-success", data: { turbo: false } do %>
        <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Réadhérer
      <% end %>
    <% end %>
  </div>
</div>
