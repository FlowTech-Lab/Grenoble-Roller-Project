<% 
  age = membership.child_age
  show_pay_cta = local_assigns.fetch(:show_pay_cta, true)
  status_class = if membership.pending? || membership.trial?
    'pending'
  elsif membership.active?
    'active'
  else
    'expired'
  end
%>

<div class="child-mini-card card-liquid" style="background: var(--liquid-glass-bg); border: 1px solid var(--card-border-color);">
  <div class="d-flex justify-content-between align-items-start gap-2">
    <div class="flex-grow-1 min-w-0">
      <div class="d-flex align-items-center mb-1">
        <i class="bi bi-person-heart text-liquid-warning me-2" aria-hidden="true"></i>
        <strong><%= membership.child_full_name %></strong>
      </div>
      <small class="text-muted d-block mb-1">
        Né(e) le <%= l(membership.child_date_of_birth, format: :short) if membership.child_date_of_birth %>
        (<%= age %> ans)
      </small>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <small class="text-muted">
          <%= membership.category == 'standard' ? 'Standard' : 'FFRS' %> - <%= membership.season %>
        </small>
        <strong>
          <%= number_to_currency(membership.total_amount_cents / 100.0, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
        </strong>
      </div>
      <small class="text-muted d-block mt-1">
        <%= l(membership.start_date, format: :short) if membership.start_date %> →
        <%= l(membership.end_date, format: :short) if membership.end_date %>
      </small>
    </div>

    <div class="child-mini-card__toolbar d-flex flex-column align-items-end gap-2 flex-shrink-0">
      <span class="badge <%= status_class == 'active' ? 'bg-success' : (status_class == 'pending' ? 'bg-warning text-dark' : 'bg-secondary') %>">
        <% if status_class == 'active' %>
          <i class="bi bi-check-circle me-1" aria-hidden="true"></i><%= t("statuses.membership.active") %>
        <% elsif status_class == 'pending' %>
          <% if membership.trial? %>
            <i class="bi bi-gift me-1" aria-hidden="true"></i><%= t("statuses.membership.trial") %>
          <% else %>
            <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i><%= t("statuses.membership.pending") %>
          <% end %>
        <% else %>
          <i class="bi bi-x-circle me-1" aria-hidden="true"></i><%= t("statuses.membership.expired") %>
        <% end %>
      </span>

      <div class="child-mini-card__actions d-flex gap-1" role="group" aria-label="Actions pour <%= membership.child_full_name %>">
        <%= link_to membership_path(membership),
            class: "btn btn-sm btn-outline-primary",
            aria: { label: "Voir les détails de #{membership.child_full_name}" } do %>
          <i class="bi bi-eye" aria-hidden="true"></i>
        <% end %>

        <% if is_pending || membership.trial? %>
          <% unless membership.trial? %>
            <%= link_to edit_membership_path(membership),
                class: "btn btn-sm btn-outline-warning",
                aria: { label: "Modifier l'adhésion de #{membership.child_full_name}" } do %>
              <i class="bi bi-pencil" aria-hidden="true"></i>
            <% end %>
            <%= button_to membership_path(membership),
                method: :delete,
                class: "btn btn-sm btn-outline-danger",
                aria: { label: "Supprimer l'adhésion de #{membership.child_full_name}" },
                data: {
                  turbo: false,
                  confirm: "Supprimer l'adhésion de #{membership.child_full_name} ?"
                },
                form: { class: "child-mini-card__inline-form" } do %>
              <i class="bi bi-trash" aria-hidden="true"></i>
            <% end %>
          <% end %>

          <% if show_pay_cta %>
            <% if membership.trial? %>
              <%= button_to upgrade_membership_path(membership),
                  method: :patch,
                  class: "btn btn-sm btn-primary",
                  data: {
                    turbo: false,
                    confirm: "Convertir l'essai de #{membership.child_full_name} en adhésion payante et l'ajouter au panier ?"
                  },
                  form: { class: "child-mini-card__inline-form" } do %>
                <i class="bi bi-basket me-1" aria-hidden="true"></i>
                Adhérer
              <% end %>
            <% else %>
              <%= unified_cart_pay_cta(membership, form_class: "child-mini-card__inline-form") %>
            <% end %>
          <% end %>
        <% elsif membership.renewable_now? %>
          <%= link_to membership_renewal_path_for(membership),
              class: "btn btn-sm btn-success",
              data: { turbo: false },
              aria: { label: "Renouveler l'adhésion de #{membership.child_full_name}" } do %>
            <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>
            Réadhérer
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
