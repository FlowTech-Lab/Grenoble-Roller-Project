<%# locals: variant: :rail | :chips %>
<% variant = local_assigns.fetch(:variant, :rail) %>

<% if variant == :chips %>
  <div class="shop-filter-chips" role="list">
    <%= link_to products_path,
        class: "shop-filter-chip #{'active' unless @selected_category}",
        role: "listitem" do %>
      Tous
      <span class="shop-filter-chip-count"><%= @active_products_count %></span>
    <% end %>

    <% @categories.each do |category| %>
      <% count = @category_counts[category.id] || 0 %>
      <% next if count <= 0 %>
      <% is_active = @selected_category&.id == category.id %>
      <%= link_to products_path(category: category.slug),
          class: "shop-filter-chip #{'active' if is_active}",
          role: "listitem" do %>
        <%= category.name %>
        <span class="shop-filter-chip-count"><%= count %></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <nav class="shop-filter-nav" aria-label="Catégories boutique">
    <h2 class="shop-filter-heading">
      <i class="bi bi-funnel me-2" aria-hidden="true"></i>Catégories
    </h2>
    <div class="d-flex flex-column gap-2">
      <%= link_to products_path,
          class: "category-filter-item text-decoration-none #{'active' unless @selected_category}" do %>
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-truncate me-2">
            <i class="bi bi-grid me-2" aria-hidden="true"></i>Tous les produits
          </span>
          <span class="badge <%= @selected_category.nil? ? 'bg-primary' : 'bg-secondary' %> flex-shrink-0"><%= @active_products_count %></span>
        </div>
      <% end %>

      <% @categories.each do |category| %>
        <%
          is_active = @selected_category&.id == category.id
          count = @category_counts[category.id] || 0
        %>
        <% if count > 0 %>
          <%= link_to products_path(category: category.slug),
              class: "category-filter-item text-decoration-none #{'active' if is_active}" do %>
            <div class="d-flex justify-content-between align-items-center">
              <span class="text-truncate me-2">
                <i class="bi bi-tag me-2" aria-hidden="true"></i><%= category.name %>
              </span>
              <span class="badge <%= is_active ? 'bg-primary' : 'bg-secondary' %> flex-shrink-0"><%= count %></span>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </nav>
<% end %>
