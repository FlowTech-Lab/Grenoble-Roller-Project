<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <div class="card card-liquid rounded-liquid shadow-liquid">
        <div class="card-body p-4">
          <% if @checkout.processing? || (@checkout.payment&.status == "pending") %>
            <div class="alert alert-warning mb-4" role="alert">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                  <strong>Paiement en cours</strong>
                  <p class="small mb-0">Vérification automatique en cours...</p>
                </div>
                <%= button_to checkout_check_payment_path(@checkout),
                    method: :post,
                    class: "btn btn-sm btn-warning",
                    data: { turbo: true } do %>
                  <i class="bi bi-arrow-clockwise me-1"></i>Vérifier maintenant
                <% end %>
              </div>
            </div>

            <script>
              (function() {
                let attempts = 0;
                const maxAttempts = 12;
                let isPolling = true;

                const poll = async () => {
                  if (!isPolling) return;

                  try {
                    const response = await fetch('<%= checkout_status_path(@checkout) %>', {
                      method: 'GET',
                      headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
                      },
                      credentials: 'same-origin',
                      cache: 'no-cache'
                    });

                    if (!response.ok) {
                      if (attempts < maxAttempts) {
                        attempts++;
                        setTimeout(poll, 5000);
                      }
                      return;
                    }

                    const data = await response.json();
                    if (data.status !== 'pending' && data.status !== 'processing' && data.status !== 'unknown') {
                      isPolling = false;
                      window.location.reload();
                    } else if (attempts < maxAttempts) {
                      attempts++;
                      setTimeout(poll, 5000);
                    }
                  } catch (_e) {
                    if (attempts < maxAttempts) {
                      attempts++;
                      setTimeout(poll, 5000);
                    }
                  }
                };

                setTimeout(poll, 3000);
              })();
            </script>
          <% elsif @checkout.paid? %>
            <div class="alert alert-success mb-4" role="alert">
              <strong>Paiement confirmé</strong>
              <p class="mb-0">Merci ! Votre paiement a été enregistré.</p>
            </div>
          <% elsif @checkout.failed? || @checkout.abandoned? %>
            <div class="alert alert-danger mb-4" role="alert">
              <strong>Paiement non abouti</strong>
              <p class="mb-0">Le paiement n'a pas pu être finalisé. Vous pouvez réessayer depuis votre panier.</p>
            </div>
          <% end %>

          <h1 class="h4 mb-3">Récapitulatif du paiement</h1>
          <ul class="list-group list-group-flush mb-3">
            <% @checkout.checkout_lines.each do |line| %>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span><%= line.label %></span>
                <span><%= format_price(line.subtotal_cents) %></span>
              </li>
            <% end %>
            <% if @checkout.donation_cents.positive? %>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span>Don</span>
                <span><%= format_price(@checkout.donation_cents) %></span>
              </li>
            <% end %>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0 fw-bold">
              <span>Total</span>
              <span><%= format_price(@checkout.total_cents) %></span>
            </li>
          </ul>

          <div class="d-flex gap-2 flex-wrap">
            <%= link_to cart_path, class: "btn btn-outline-primary" do %>
              <i class="bi bi-basket me-1"></i>Retour au panier
            <% end %>
            <%= link_to root_path, class: "btn btn-liquid-primary" do %>
              <i class="bi bi-house me-1"></i>Accueil
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
