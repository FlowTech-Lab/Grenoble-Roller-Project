<div class="card card-liquid rounded-liquid mb-3" aria-labelledby="donationTitle" data-checkout-selection-target="donationBlock">
  <div class="card-body p-4">
    <h3 id="donationTitle" class="h5 text-liquid-primary mb-3">
      <i class="bi bi-heart me-2"></i>Souhaitez-vous ajouter un don à Grenoble Roller ?
    </h3>
    <div class="d-flex flex-wrap gap-2 align-items-center">
      <div class="form-check">
        <input class="form-check-input" type="radio" name="donation_ui" id="don0" value="0" checked
               data-action="checkout-selection#setDonation"
               data-donation-cents="0">
        <label class="form-check-label" for="don0">Pas de don</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="radio" name="donation_ui" id="don2" value="2"
               data-action="checkout-selection#setDonation"
               data-donation-cents="200">
        <label class="form-check-label" for="don2">2 €</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="radio" name="donation_ui" id="don3" value="3"
               data-action="checkout-selection#setDonation"
               data-donation-cents="300">
        <label class="form-check-label" for="don3">3 €</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="radio" name="donation_ui" id="don5" value="5"
               data-action="checkout-selection#setDonation"
               data-donation-cents="500">
        <label class="form-check-label" for="don5">5 €</label>
      </div>
      <div class="d-flex align-items-center gap-2">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="donation_ui" id="donCustom" value="custom"
                 data-action="checkout-selection#enableCustomDonation">
          <label class="form-check-label" for="donCustom">Choisir un montant</label>
        </div>
        <input type="number" min="0" step="0.5" class="form-control form-control-liquid"
               id="donationCustomInput" placeholder="0,00" style="max-width: 140px;" disabled
               data-checkout-selection-target="customDonationInput"
               data-action="input->checkout-selection#setCustomDonation">
      </div>
    </div>
  </div>
</div>
